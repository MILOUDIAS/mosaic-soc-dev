# Physical flow: the PDK clone, run trees and layout binaries are never
# versioned. Signoff results are published as release assets.
/flow/librelane/gf180mcu/
/flow/librelane/*/runs/*/*
!/flow/librelane/*/runs/*/final/
/flow/librelane/*/runs/*/final/*
# Exception: the measured metrics that the area model, the waivers and the
# status tables cite. Small text, no layout data.
!/flow/librelane/*/runs/*/final/metrics.json
!/flow/librelane/*/runs/*/*-odb-reportdisconnectedpins/
/flow/librelane/*/runs/*/*-odb-reportdisconnectedpins/*
!/flow/librelane/*/runs/*/*-odb-reportdisconnectedpins/full_disconnected_pins_table.txt
/flow/librelane/**/final_*/
/flow/librelane/experimental/.generated_*.yaml
/flow/librelane/experimental/.resolved_*.yaml
/flow/librelane/experimental/.filelist_*.yaml
*.gds
*.odb
*.spef
*.sdf
*.mag

