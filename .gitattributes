# Chipathon Block A physical deliverables are large binaries/text dumps that
# git compresses poorly. Track them with LFS so clones stay usable.
# Scoped to the kept deliverable path only -- everything else under
# flow/librelane/experimental/runs/ is gitignored.
*.gds   filter=lfs diff=lfs merge=lfs -text
*.odb   filter=lfs diff=lfs merge=lfs -text
*.mag   filter=lfs diff=lfs merge=lfs -text
*.spef  filter=lfs diff=lfs merge=lfs -text
*.sdf   filter=lfs diff=lfs merge=lfs -text
*.def   filter=lfs diff=lfs merge=lfs -text
